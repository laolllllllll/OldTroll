#!/bin/sh

# Remove only the AppSync copies owned by OldTroll. The bundled Substrate
# runtime is left in place because other tweaks may already rely on it.
ASU_PLIST=/usr/libexec/oldtroll/appsync/com.cor.oldtroll.asu-inject.plist
if [ -x /bin/launchctl ]; then
    /bin/launchctl unload "$ASU_PLIST" > /dev/null 2>&1 || true
fi
rm -f /Library/MobileSubstrate/DynamicLibraries/OldTrollAppSync-installd.plist
rm -f /Library/MobileSubstrate/DynamicLibraries/OldTrollAppSync-installd.dylib
rm -f /Library/MobileSubstrate/DynamicLibraries/OldTrollAppSync-FrontBoard.plist
rm -f /Library/MobileSubstrate/DynamicLibraries/OldTrollAppSync-FrontBoard.dylib
rm -f /Library/LaunchDaemons/com.cor.oldtroll.asu-inject.plist

if [ -x /bin/launchctl ]; then
    /bin/launchctl unload /System/Library/LaunchDaemons/com.apple.mobile.installd.plist > /dev/null 2>&1 || true
    /bin/launchctl load /System/Library/LaunchDaemons/com.apple.mobile.installd.plist > /dev/null 2>&1 || true
fi

if [ -x /usr/bin/uicache ]; then
    /usr/bin/uicache > /dev/null 2>&1 || true
fi

exit 0
